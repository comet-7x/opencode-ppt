{
  "include": ["app", "tests"],
  "exclude": ["**/.*", "**/.venv", "**/__pycache__", "**/node_modules"],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportUnusedImport": "warning",
  "reportUnnecessaryTypeIgnoreComment": "warning"
}
